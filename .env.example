# Demo works without API keys. Restart after editing.
APP_MODE=live
DATA_DIR=data
OPENAI_API_KEY=
CONTENT_MODEL=gpt-6.1-sol
RESEARCH_MODEL=gpt-6-luna
TTS_PROVIDER=openai
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral
GROQ_API_KEY=
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy
IMAGE_MODEL=gpt-image-2.5-flare
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
YOUTUBE_API_KEY=
# Optional third-party TikTok metadata research. No creator videos are downloaded.
APIFY_API_TOKEN=
APIFY_MAX_CHARGE_USD=0.5
# Google OAuth client must have youtube.upload scope. Tokens stay server-side.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# TikTok: manual export or Buffer automatic publishing.
TIKTOK_PUBLISHER=manual
BUFFER_API_KEY=
BUFFER_TIKTOK_CHANNEL_ID=
# Buffer fetches your approved video from a public HTTPS media URL.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional path to an installed FFmpeg executable; bundled binary used otherwise.
FFMPEG_PATH=
